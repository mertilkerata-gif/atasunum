# ─────────────────────────────────────────
# Supabase (prod'da doldur, demo'da boş bırak)
# ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─────────────────────────────────────────
# OpenAI (AI Analyst + Operasyon Reçetesi için)
# ─────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────
# n8n Webhook Güvenliği
# Her webhook isteğinde Header olarak gönderilir:
#   x-webhook-secret: bu_değer
# Boş bırakılırsa demo modda bypass edilir
# ─────────────────────────────────────────
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_buraya

# ─────────────────────────────────────────
# Harici API Erişimi (tablet, BI araçları)
# Header: x-api-key: bu_değer
# Boş bırakılırsa demo modda bypass edilir
# ─────────────────────────────────────────
MUTFAK_NABZI_API_KEY=your_api_key_buraya
